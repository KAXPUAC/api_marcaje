                    "type": "string",
                    "required": true
                }
            ],
            "request": null,
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "array|object",
                "body": "Respuesta de DBAFISICC.PKG_PEOPLE.DATOSNOPERSONALTB"
            }
        },
        {
            "name": "Información de docente",
            "method": "GET",
            "path": "/api/v1/people/info_doc",
            "authentication_required": true,
            "parameters": [
                {
                    "name": "correlativo",
                    "location": "query",
                    "type": "string",
                    "required": true
                }
            ],
            "request": null,
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "array|object",
                "body": "Respuesta de DBAFISICC.PKG_PEOPLE.DATOSNOPERSONALTB"
            }
        },
        {
            "name": "Marcar ingreso de personal",
            "method": "POST",
            "path": "/api/v1/people/marcar",
            "authentication_required": true,
            "content_type": "application/x-www-form-urlencoded",
            "parameters": [
                {
                    "name": "codpers",
                    "location": "query",
                    "type": "string",
                    "required": true
                }
            ],
            "request": null,
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "string|object",
                "body": "Respuesta de DBAFISICC.PKG_PERSONAL.INGRESO_PERSONAL"
            }
        },
        {
            "name": "Marcar ingreso de docente",
            "method": "POST",
            "path": "/api/v1/people/marcar_doc",
            "authentication_required": true,
            "content_type": "application/x-www-form-urlencoded",
            "parameters": [
                {
                    "name": "codpers",
                    "location": "query",
                    "type": "string",
                    "required": true
                },
                {
                    "name": "laboratorio",
                    "location": "query",
                    "type": "string",
                    "required": true
                }
            ],
            "request": null,
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "string|object",
                "body": "Respuesta de DBAFISICC.PKG_PERSONAL.INGRESO_DOCENTE"
            }
        },
        {
            "name": "Reconocer rostro por departamento",
            "method": "POST",
            "path": "/api/v1/recognize",
            "authentication_required": true,
            "content_type": "multipart/form-data",
            "parameters": [
                {
                    "name": "file",
                    "location": "multipart",
                    "type": "file",
                    "required": true,
                    "accepted_types": [
                        "image/jpeg",
                        "image/png"
                    ]
                },
                {
                    "name": "departamento",
                    "location": "multipart",
                    "type": "string",
                    "required": true
                }
            ],
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "RecognizeResponse",
                "body": {
                    "success": true,
                    "departamento": "ADM",
                    "correlativo": "12345",
                    "datos_info": [],
                    "similarity": 96.5,
                    "face_id": "face-id",
                    "confidence": 99.1,
                    "message": null
                }
            }
        },
        {
            "name": "Reconocer rostro automáticamente",
            "method": "POST",
            "path": "/api/v1/recognize/automatic",
            "authentication_required": false,
            "content_type": "multipart/form-data",
            "parameters": [
                {
                    "name": "file",
                    "location": "multipart",
                    "type": "file",
                    "required": true,
                    "accepted_types": [
                        "image/jpeg",
                        "image/png"
                    ]
                }
            ],
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "TokenResponse",
                "body": {
                    "access_token": "eyJ...",
                    "refresh_token": "eyJ...",
                    "expires_in": 1800,
                    "refresh_expires_in": 2592000,
                    "token_type": "bearer",
                    "username": "usuario",
                    "email": "usuario@example.com",
                    "correlativo": "12345",
                    "auth_method": "facial",
                    "datos_usuario": {}
                }
            }
        },
        {
            "name": "Sincronizar departamento",
            "method": "POST",
            "path": "/api/v1/sync/departamento/{coddepa}/",
            "authentication_required": false,
