{
    "name": "API Marcaje",
    "version": "1.0.0",
    "description": "Documentación de los endpoints disponibles para consumir la API.",
    "base_url": "http://localhost:8000",
    "api_prefix": "/api/v1",
    "openapi_source": "/openapi.json",
    "swagger_ui": "/docs",
    "redoc_ui": "/redoc",
    "authentication": {
        "type": "Bearer JWT",
        "header": "Authorization: Bearer <access_token>",
        "access_token_expires_in_seconds": 1800,
        "refresh_token_expires_in_seconds": 2592000,
        "renew_endpoint": "POST /api/v1/auth/token/refresh",
        "logout_endpoint": "POST /api/v1/auth/logout"
    },
    "face_liveness": {
        "confidence_threshold": 90,
        "session_ttl_seconds": 180,
        "session_reuse": "not_allowed",
        "client_requirement": "El cliente debe completar la sesión utilizando Amazon Amplify Face Liveness mediante un WebView.",
        "identity_pool_id": "Identificador público de Cognito utilizado por Amplify para configurar el Identity Pool y obtener credenciales temporales; no es una clave AWS.",
        "identity_pool_requirements": [
            "El Identity Pool debe permitir acceso guest/no autenticado para el flujo de Face Liveness.",
            "El rol guest debe tener únicamente los permisos necesarios para el streaming, empezando por rekognition:StartFaceLivenessSession.",
            "Las credenciales administrativas y las claves AWS permanentes permanecen exclusivamente en el backend."
        ]
    },
    "common_errors": {
        "400": {
            "content_type": "application/json",
            "body": {
                "detail": "Descripción del error"
            }
        },
        "401": {
            "content_type": "application/json",
            "body": {
                "detail": "Invalid authentication credentials"
            },
            "action": "Renovar el access_token usando el refresh_token."
        },
        "500": {
            "content_type": "application/json",
            "body": {
                "detail": "Descripción del error interno"
            }
        }
    },
    "endpoints": [
        {
            "name": "Health check",
            "method": "GET",
            "path": "/health",
            "authentication_required": false,
            "parameters": [],
            "request": null,
            "response": {
                "status": 200,
                "content_type": "application/json",
                "body": {
                    "status": "ok"
                }
            }
        },
        {
            "name": "Iniciar sesión",
            "method": "POST",
            "path": "/api/v1/auth/token",
            "authentication_required": false,
            "content_type": "application/x-www-form-urlencoded",
            "parameters": [
                {
                    "name": "username",
                    "location": "form",
                    "type": "string",
                    "required": true
                },
                {
                    "name": "password",
                    "location": "form",
                    "type": "string",
                    "required": true
                }
            ],
            "request_example": "username=usuario&password=clave",
            "response": {
                "status": 200,
                "content_type": "application/json",
                "body": {
                    "access_token": "eyJ...",
                    "refresh_token": "eyJ...",
                    "expires_in": 1800,
                    "refresh_expires_in": 2592000,
                    "token_type": "bearer",
                    "username": "usuario",
                    "email": "usuario@example.com",
                    "correlativo": "12345",
                    "auth_method": "password",
                    "datos_usuario": {}
                }
            }
        },
        {
            "name": "Renovar tokens",
            "method": "POST",
            "path": "/api/v1/auth/token/refresh",
            "authentication_required": false,
            "content_type": "application/json",
            "request": {
                "refresh_token": "eyJ..."
            },
            "response": {
                "status": 200,
                "content_type": "application/json",
                "body": {
                    "access_token": "eyJ...",
                    "refresh_token": "eyJ...",
                    "expires_in": 1800,
                    "refresh_expires_in": 2592000,
                    "token_type": "bearer",
                    "username": "usuario",
                    "email": "usuario@example.com",
                    "correlativo": "12345",
                    "auth_method": "password",
                    "datos_usuario": {}
                }
            },
            "notes": [
                "El refresh_token anterior queda invalidado después de una renovación exitosa.",
                "Debe guardarse el nuevo refresh_token devuelto por la API."
            ]
        },
        {
            "name": "Cerrar sesión",
            "method": "POST",
            "path": "/api/v1/auth/logout",
            "authentication_required": false,
            "content_type": "application/json",
            "request": {
                "refresh_token": "eyJ..."
            },
            "response": {
                "status": 200,
                "content_type": "application/json",
                "body": {
                    "message": "Sesión cerrada correctamente"
                }
            }
        },
        {
            "name": "Obtener usuario autenticado",
            "method": "GET",
            "path": "/api/v1/auth/users/me",
            "authentication_required": true,
            "parameters": [],
            "request": null,
            "response": {
                "status": 200,
                "content_type": "application/json",
                "body": {
                    "message": "Acceso concedido",
                    "user": {
                        "username": "usuario",
                        "email": "usuario@example.com",
                        "exp": 1762345600,
                        "token_type": "access"
                    }
                }
            }
        },
        {
            "name": "Información de colaborador administrativo",
            "method": "GET",
            "path": "/api/v1/people/info_admin",
            "authentication_required": true,
            "parameters": [
                {
                    "name": "correlativo",
                    "location": "query",
                    "type": "string",
                    "required": true
                }
            ],
            "request": null,
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "array|object",
                "body": "Respuesta de DBAFISICC.PKG_PEOPLE.DATOSNOPERSONALTB"
            }
        },
        {
            "name": "Información de docente",
            "method": "GET",
            "path": "/api/v1/people/info_doc",
            "authentication_required": true,
            "parameters": [
                {
                    "name": "correlativo",
                    "location": "query",
                    "type": "string",
                    "required": true
                }
            ],
            "request": null,
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "array|object",
                "body": "Respuesta de DBAFISICC.PKG_PEOPLE.DATOSNOPERSONALTB"
            }
        },
        {
            "name": "Crear sesión de Face Liveness",
            "method": "POST",
            "path": "/api/v1/recognize/liveness/session",
            "authentication_required": false,
            "content_type": "application/json",
            "request": {
                "flow": "login"
            },
            "parameters": [],
            "response": {
                "status": 200,
                "content_type": "application/json",
                "body": {
                    "session_id": "liveness-session-id",
                    "region": "us-east-1",
                    "identity_pool_id": "us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                }
            },
            "notes": [
                "El flujo login es el valor predeterminado.",
                "Para reconocimiento, enviar flow=recognize.",
                "El cliente debe usar session_id, region e identity_pool_id con Amazon Amplify Face Liveness.",
                "identity_pool_id es un identificador público de Cognito para obtener credenciales temporales; no es una clave AWS."
            ]
        },
        {
            "name": "Login facial con Face Liveness",
            "method": "POST",
            "path": "/api/v1/auth/facial/liveness",
            "authentication_required": false,
            "content_type": "application/json",
            "request": {
                "session_id": "liveness-session-id"
            },
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "TokenResponse",
                "body": {
                    "access_token": "eyJ...",
                    "refresh_token": "eyJ...",
                    "expires_in": 1800,
                    "refresh_expires_in": 2592000,
                    "token_type": "bearer",
                    "username": "usuario",
                    "email": "usuario@example.com",
                    "correlativo": "12345",
                    "auth_method": "facial_liveness",
                    "datos_usuario": {}
                },
                "failure_body": {
                    "success": false,
                    "is_live": false,
                    "liveness_score": 18.4,
                    "spoof_detected": true,
                    "access_token": null,
                    "refresh_token": null,
                    "message": "No se pudo verificar que exista una persona real frente a la cámara."
                }
            }
        },
        {
            "name": "Reconocimiento global con Face Liveness",
            "method": "POST",
            "path": "/api/v1/recognize/search/liveness",
            "authentication_required": false,
            "content_type": "application/json",
            "request": {
                "session_id": "liveness-session-id"
            },
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "RecognizedUserResponse",
                "body": {
                    "Codpers": "9876",
                    "Usuario": "jperez",
                    "TipoUsuario": "Administrativo",
                    "Correlativo": 12345,
                    "Coddepa": "ADM",
                    "Departamento": "Administración",
                    "Usuarios": []
                }
            }
        },
        {
            "name": "Reconocer rostro por departamento",
            "method": "POST",
            "path": "/api/v1/recognize",
            "authentication_required": true,
            "content_type": "multipart/form-data",
            "parameters": [
                {
                    "name": "file",
                    "location": "multipart",
                    "type": "file",
                    "required": true,
                    "accepted_types": [
                        "image/jpeg",
                        "image/png"
                    ]
                },
                {
                    "name": "departamento",
                    "location": "multipart",
                    "type": "string",
                    "required": true
                }
            ],
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "RecognizeResponse",
                "body": {
                    "success": true,
                    "departamento": "ADM",
                    "correlativo": "12345",
                    "datos_info": [],
                    "similarity": 96.5,
                    "face_id": "face-id",
                    "confidence": 99.1,
                    "message": null
                }
            }
        },
        {
            "name": "Login facial",
            "method": "POST",
            "path": "/api/v1/auth/facial",
            "authentication_required": false,
            "content_type": "multipart/form-data",
            "parameters": [
                {
                    "name": "file",
                    "location": "multipart",
                    "type": "file",
                    "required": true,
                    "accepted_types": [
                        "image/jpeg",
                        "image/png"
                    ]
                }
            ],
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "TokenResponse"
            }
        },
        {
            "name": "Sincronizar departamento",
            "method": "POST",
            "path": "/api/v1/sync/departamento/{coddepa}/",
            "authentication_required": true,
            "parameters": [
                {
                    "name": "coddepa",
                    "location": "path",
                    "type": "string",
                    "required": true
                }
            ],
            "request": null,
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "object|array",
                "body": "Resultado de la sincronización del departamento"
            }
        },
        {
            "name": "Estado del departamento",
            "method": "POST",
            "path": "/api/v1/sync/departamento/{coddepa}/status/",
            "authentication_required": true,
            "parameters": [
                {
                    "name": "coddepa",
                    "location": "path",
                    "type": "string",
                    "required": true
                }
            ],
            "request": null,
            "response": {
                "status": 200,
                "content_type": "application/json",
                "body": {
                    "Coleccion": "depto_adm",
                    "Cantidad Rostros": 10,
                    "Creado": "2026-01-01 12:00:00"
                },
                "not_found_body": {
                    "collection_id": "depto_adm",
                    "face_count": 0,
                    "exists": false
                }
            }
        },
        {
            "name": "Listar departamentos",
            "method": "GET",
            "path": "/api/v1/sync/departamentos",
            "authentication_required": true,
            "parameters": [],
            "request": null,
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "array",
                "body": "Lista de departamentos obtenida desde Oracle"
            }
        }
    ]
}
