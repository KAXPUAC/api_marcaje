        {
            "name": "Listar departamentos",
            "method": "GET",
            "path": "/api/v1/sync/departamentos",
            "authentication_required": false,
            "parameters": [],
            "request": null,
            "response": {
                "status": 200,
                "content_type": "application/json",
                "type": "array",
